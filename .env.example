# Resend (https://resend.com) — usado por app/api/contact/route.ts para
# enviar los mensajes del formulario de contacto a comunicacion@colonia.cloud
RESEND_API_KEY=

# Payload CMS: usar una clave aleatoria larga y mantenerla fuera del repositorio.
PAYLOAD_SECRET=

# Directorio escribible y persistente para SQLite y las imágenes del blog.
# En Hostinger, configurar una ruta absoluta fuera del directorio reemplazado al desplegar.
PAYLOAD_DATA_DIR=./data
